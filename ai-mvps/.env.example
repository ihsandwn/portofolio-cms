# AI Products Environment Configuration Template
# Copy this to each MVP's .env.local (recommended) and fill in your values.
# Do NOT commit real credentials. Keep .env files gitignored.

# ================================================================================
# Gemini AI Configuration (REQUIRED for all environments)
# ================================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ================================================================================
# Gemini AI Model Selection (OPTIONAL)
# ================================================================================
# Defaults to gemini-2.5-flash when unset
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ================================================================================
# Laravel CMS Integration (REQUIRED for temporary MVP access)
# ================================================================================
LARAVEL_API_URL=http://localhost:8000
NEXT_PUBLIC_LARAVEL_API_URL=http://localhost:8000

# ================================================================================
# Rate limiting (process-local baseline; shared store required for production)
# ================================================================================
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=600000